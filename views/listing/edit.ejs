<% layout("/layouts/boilerplate")%>
<body>
    <h4>EDIT YOUR DETAILS</h4>

    <form method="POST" action="/listing/<%= list._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">

        <div class="col-8 offset-2">
        <br>
        <h1>EDIT DETAILS</h1>
        <br>
        <div class="mb-3">
            <label for="title" class="form-lable">Title</label>
            <input type="text" name="list[title]" value="<%= list.title%>" class="form-control" required>
            <div class="valid-feedback">it's looking good</div>
            <div class="invalid-feedback">please type valid title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-lable">Description</label>
            <textarea  cols="60" name="list[description]" class="form-control" rows="10"><%= list.description%> required</textarea>
            <div class="valid-feedback">it's looking good</div>
            <div class="invalid-feedback">please type valid description</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-lable">Image</label>
            <input type="file" name="list[image]" class="form-control" >
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-lable">Price</label>
            <input type="number" name="list[price]" value="<%= list.price%>" class="form-control" required>
            <div class="valid-feedback">it's looking good</div>
            <div class="invalid-feedback">please enter valid price</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="location" class="form-lable">Location</label>
            <input type="text" name="list[location]" class="form-control" value="<%= list.location%>" required>
            <div class="valid-feedback">it's looking good</div>
            <div class="invalid-feedback">please type valid location name</div>
        </div>
        </div>
        <div class="mb-3">
            <label for="country" class="form-lable">Country</label>
            <input type="text" name="list[country]" value="<%= list.country%>" class="form-control" required>
            <div class="valid-feedback">it's looking good</div>
            <div class="invalid-feedback">please type valid country name</div>
        </div>
        <br>
        <button class="btn btn-dark">Submit</button>
        </div>
        <br>


        
