<% layout("/layouts/boilerplate")%>
    <h4 style="margin-top: 5rem !important;"><b>LIST OF ALL PROPERTIES</b></h4>
    <hr>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 ">
        <% for(let list of listingItm){ %>
            <a href="/listing/<%= list._id %>">
                <div class="col">
                <div class="card h-100 border-0 style"width: 16rem >
                    <img src="<%= list.image.url %>" class="card-img-top style" alt="list_image">
                    <div class="card-img-overlay"><b><%= list.title %></b></div>
                    <div class="card-body-data">
                        <h5 class="card-title"><%= list.description %></h5>
                        <p class="card-text">&#8377;<%= list.price.toLocaleString("en-IN") %></p>
                    </div>
                </div>
            </div>
            </a>
        <% } %>
    </div>






