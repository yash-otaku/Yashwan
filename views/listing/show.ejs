<% layout("/layouts/boilerplate")%>
<body>
    <div class="container-fluid">
        <h1><%=list.title%></h1>
        <br>

        <a href="/listing" class="btn btn-dark">Home</a>
        <br><br>
        <div class="card h-100 border-0" style="width: 30rem;">
        <img src="<%=list.image.url%>" class="card-img-top" alt="list_image">
        <div class="card-body">
            <br>
            <p class="card-text">OWNED BY : <%=list.owner.username%></p>
            <p class="card-text"><%=list.description%></p>
            <p class="card-text">&#8377;<%= list.price.toLocaleString("en-IN")%></p>
            <p class="card-text"><%=list.location%></p>
            <p class="card-text"><%=list.country%></p>
        </div>
        <%if(currentUser && currentUser._id.equals(list.owner._id)){%>
            <br>
            <a class="btn btn-dark" method="GET" href="/listing/<%= list._id%>/delete">DELETE</a>
            <br>
            <br>
            <a href="/listing/<%= list._id%>/edit" class="btn btn-dark">EDIT DETAILS</a>
            <br>
            <br>
            <hr>
        <%}%>
    </div>
  
</body>


