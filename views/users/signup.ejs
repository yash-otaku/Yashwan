<% layout("/layouts/boilerplate")%>

<div class="mt-3">
    <h1 class="col-8 offset-2">SignUp for AIR BNB</h1>
    <div class="col-8 offset-2">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input required type="text" name="username" id="username" placeholder="username" class="form-control">
                <div class="valid-feedback">it's looking good</div>
                <div class="invalid-feedback">please type username</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">email</label>
                <input required type="text" name="email" id="email" placeholder="email" class="form-control">
                <div class="valid-feedback">it's looking good</div>
                <div class="invalid-feedback">please type valid email</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">password</label>
                <input required type="password" name="password" id="password" placeholder="password" class="form-control">
                <div class="valid-feedback">it's looking good</div>
                <div class="invalid-feedback">please type valid password</div>
            </div>
            <button class="btn btn-success">Submit</button>
            <br>
            <br>
        </form>
    </div>          
</div>
